rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- who is calling ----
    function signedIn() { return request.auth != null; }
    function devicePath() { return /databases/$(database)/documents/devices/$(request.auth.uid); }
    function registered() { return signedIn() && exists(devicePath()); }
    function me() { return get(devicePath()).data.personId; }
    // The caller's person as it will be after this write (registration batches).
    function meAfter() { return getAfter(devicePath()).data.personId; }

    function nameOk(n) { return n is string && n.size() > 0 && n.size() <= 30; }

    // ---- people and devices ----
    match /people/{personId} {
      allow get: if registered();
      allow create: if signedIn() && personId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && nameOk(request.resource.data.name);
      allow update: if registered() && me() == personId
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && nameOk(request.resource.data.name);
    }

    function validDevice(uid, d) {
      return (d.via == 'self' && d.personId == uid && d.keys().hasOnly(['personId', 'via']))
        || (d.via == 'link' && d.keys().hasOnly(['personId', 'via', 'code'])
            && exists(/databases/$(database)/documents/linkCodes/$(d.code))
            && get(/databases/$(database)/documents/linkCodes/$(d.code)).data.personId == d.personId
            && get(/databases/$(database)/documents/linkCodes/$(d.code)).data.expiresAt > request.time)
        || (d.via == 'recovery' && d.keys().hasOnly(['personId', 'via', 'code'])
            && exists(/databases/$(database)/documents/recoveryCodes/$(d.code))
            && get(/databases/$(database)/documents/recoveryCodes/$(d.code)).data.personId == d.personId);
    }

    match /devices/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && uid == request.auth.uid && validDevice(uid, request.resource.data);
      allow update: if signedIn() && uid == request.auth.uid
        && request.resource.data.via != 'self' && validDevice(uid, request.resource.data);
    }

    match /linkCodes/{code} {
      allow get: if signedIn();
      allow create: if registered()
        && request.resource.data.keys().hasOnly(['personId', 'expiresAt'])
        && request.resource.data.personId == me()
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm');
      allow delete: if registered() && resource.data.personId == me();
    }

    match /recoveryCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['personId'])
        && request.resource.data.personId == meAfter();
    }

    // ---- trips ----
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---- value checks (only the fields the app writes, with the expected types) ----
    function strOk(v, max) { return v is string && v.size() <= max; }
    function optDate(v) { return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function optInt(v, lo, hi) { return v == null || (v is int && v >= lo && v <= hi); }
    function optHM(v) { return v == null || (v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')); }
    function zoneOk(z) {
      return z in ['Asia/Shanghai', 'Asia/Seoul', 'Asia/Tokyo', 'Asia/Taipei', 'Asia/Hong_Kong', 'Asia/Bangkok',
        'Asia/Ho_Chi_Minh', 'Asia/Singapore', 'Europe/London', 'Europe/Paris', 'America/New_York', 'America/Los_Angeles'];
    }
    function validTrip(d) {
      return d.keys().hasOnly(['name', 'destination', 'fromCode', 'toCode', 'startDate', 'days', 'timeZone',
          'countryCode', 'currency', 'notes', 'ownerId', 'memberIds', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && strOk(d.get('destination', ''), 60) && strOk(d.get('fromCode', ''), 4) && strOk(d.get('toCode', ''), 4)
        && optDate(d.get('startDate', null)) && optInt(d.get('days', null), 1, 60)
        && zoneOk(d.timeZone) && strOk(d.get('countryCode', ''), 2) && strOk(d.get('currency', ''), 3)
        && strOk(d.get('notes', ''), 2000) && d.memberIds is list && d.memberIds.size() <= 50;
    }
    function validItem(d) {
      return d.keys().hasOnly(['day', 'start', 'end', 'title', 'place', 'localName', 'localAddress', 'transit',
          'mapUrl', 'category', 'cost', 'memo', 'done'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && optInt(d.get('day', null), 1, 60) && optHM(d.get('start', null)) && optHM(d.get('end', null))
        && (d.get('cost', null) == null || (d.cost is number && d.cost >= 0))
        && d.get('done', false) is bool
        && strOk(d.get('place', ''), 80) && strOk(d.get('localName', ''), 80) && strOk(d.get('localAddress', ''), 160)
        && strOk(d.get('transit', ''), 80) && strOk(d.get('mapUrl', ''), 500) && strOk(d.get('memo', ''), 2000)
        && strOk(d.get('category', ''), 10);
    }
    function validCheck(d) {
      return d.keys().hasOnly(['name', 'checked', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.get('checked', false) is bool && d.get('order', 0) is number;
    }
    function validEntry(d) {
      return d.keys().hasOnly(['day', 'title', 'body', 'authorId', 'updatedAt'])
        && optInt(d.get('day', null), 1, 60) && strOk(d.get('title', ''), 60) && strOk(d.get('body', ''), 10000);
    }

    function tripPath(tripId) { return /databases/$(database)/documents/trips/$(tripId); }
    function invitePath(tripId) { return /databases/$(database)/documents/trips/$(tripId)/private/invite; }
    function isMember(tripId) { return registered() && me() in get(tripPath(tripId)).data.memberIds; }
    function isOwnerAfter(tripId) { return registered() && getAfter(tripPath(tripId)).data.ownerId == me(); }

    match /trips/{tripId} {
      allow read: if registered() && me() in resource.data.memberIds;
      allow create: if registered()
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()]
        && validTrip(request.resource.data);
      allow update: if registered() && unchanged('ownerId') && validTrip(request.resource.data) && (
        // members edit details
        (me() in resource.data.memberIds && unchanged('memberIds'))
        // the owner adds or removes members but stays a member
        || (resource.data.ownerId == me() && me() in request.resource.data.memberIds)
        // a member other than the owner leaves
        || (me() in resource.data.memberIds && resource.data.ownerId != me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([me()]))
        // a non-member joins themselves with the current invite code
        || (!(me() in resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds == resource.data.memberIds.concat([me()])
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/joins/$(me())).data.code
               == get(invitePath(tripId)).data.code)
      );
      allow delete: if registered() && resource.data.ownerId == me();

      match /private/invite {
        allow read: if registered() && get(tripPath(tripId)).data.ownerId == me();
        allow write: if isOwnerAfter(tripId)
          && request.resource.data.keys().hasOnly(['code']);
      }

      match /joins/{personId} {
        allow create: if registered() && personId == me()
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code == get(invitePath(tripId)).data.code;
        allow update: if registered() && personId == me()
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code == get(invitePath(tripId)).data.code;
        // the owner clears a removed member's join record
        allow delete: if registered() && get(tripPath(tripId)).data.ownerId == me();
      }

      match /items/{id} {
        allow read, delete: if isMember(tripId);
        allow create, update: if isMember(tripId) && validItem(request.resource.data);
      }

      match /checklist/{id} {
        allow read, delete: if isMember(tripId);
        allow create, update: if isMember(tripId) && validCheck(request.resource.data);
      }

      match /journal/{id} {
        allow read, delete: if isMember(tripId);
        allow create: if isMember(tripId) && validEntry(request.resource.data) && request.resource.data.authorId == me();
        allow update: if isMember(tripId) && validEntry(request.resource.data) && request.resource.data.authorId == resource.data.authorId;
      }
    }

    match /inviteCodes/{code} {
      allow get: if registered();
      allow create: if isOwnerAfter(request.resource.data.tripId)
        && request.resource.data.keys().hasOnly(['tripId']);
      allow delete: if registered() && get(tripPath(resource.data.tripId)).data.ownerId == me();
    }
  }
}
